// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Prisma v7 format:
// - datasource block has NO url field (moved to prisma.config.ts)
// - generator uses provider = "prisma-client" (not prisma-client-js)
// - output is REQUIRED in v7

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // url is configured in prisma.config.ts (Prisma v7 requirement)
  provider = "postgresql"
}

// ============ AUTH ============
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin") // "admin" | "editor"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ CATALOG (dynamic, admin-managed) ============
model Design {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  category    String   // CategorySlug
  style       String
  bedrooms    Int
  bathrooms   Int
  stories     Int
  garage      Int
  area        Int
  price       Int
  rating      Float    @default(0)
  reviews     Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  hero        String
  thumbnail   String
  description String
  // JSON fields stored as Text in PostgreSQL
  story          String @default("[]")
  highlights     String @default("[]")
  videoTour      String @default("{}")
  specifications String @default("[]")
  floorPlans     String @default("[]")
  exterior       String @default("[]")
  interiors      String @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  images     DesignImage[]

  @@index([category])
  @@index([featured])
  @@index([published])
}

model DesignImage {
  id        String   @id @default(cuid())
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  type      String   @default("image") // "image" | "video" | "panoramic"
  span      String?  // "full" | "wide" | "tall" | "square" | "small"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([designId])
}

// ============ MARQUEE ============
model MarqueeItem {
  id        String   @id @default(cuid())
  text      String
  href      String?
  icon      String?  // optional lucide icon name
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============ CONTACT ============
model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  designSlug String? // if message is about a specific design
  read       Boolean  @default(false)
  replied    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ============ GENERIC SITE ASSET (R2 reference) ============
model SiteAsset {
  id        String   @id @default(cuid())
  key       String   @unique // R2 object key
  url       String   // public URL (R2 public bucket URL or CDN)
  filename  String
  mimeType  String
  size      Int
  category  String   @default("design") // "design" | "marquee" | "hero" | "misc"
  createdAt DateTime @default(now())

  @@index([category])
}
